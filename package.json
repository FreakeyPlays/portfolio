{
  "name": "portfolio",
  "type": "module",
  "version": "2.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "format-unsafe": "biome check --write --unsafe .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@sveltia/cms": "^0.201.1",
    "astro": "^7.2.5",
    "astro-typewriter": "^1.2.0",
    "reading-time": "^1.5.0",
    "satteri": "^0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true --colors=off"
    ]
  }
}
