---
import { getCollection } from 'astro:content';
import IconMarquee from '@components/marquee/IconMarquee.astro';

interface Props {
  categories: string[];
}

type SkillIcon = ((_props: astroHTML.JSX.SVGAttributes) => unknown) & ImageMetadata;

const DECAY_BASE = 2.6;
const MIN_ITEMS = 5;
const MAX_ITEMS = 12;
const SLOWEST_CROSSING = 40;
const CROSSING_FLOOR = 20;

const crossingTimeFor = (itemCount: number) => {
  const steps = Math.min(Math.max(itemCount, MIN_ITEMS), MAX_ITEMS) - MIN_ITEMS;
  const crossingTime = CROSSING_FLOOR + (SLOWEST_CROSSING - CROSSING_FLOOR) / DECAY_BASE ** steps;

  return Math.round(crossingTime * 10) / 10;
};

const { categories } = Astro.props;

const iconModules = import.meta.glob('../../assets/icons/*.svg', {
  eager: true,
  import: 'default',
}) as Record<string, SkillIcon>;

const iconFor = (imagePath: string) =>
  iconModules[`../../assets/icons/${imagePath.split('/').pop()}`];

const skillCategories = await getCollection('skills');

const rows = categories
  .map((id) => skillCategories.find((category) => category.id === id))
  .filter((category) => category !== undefined)
  .map((category) => ({
    category: category.data.category,
    skills: category.data.skills
      .filter((skill) => !skill.hidden && skill.icon)
      .map((skill) => ({ name: skill.name, icon: iconFor(skill.icon as string) }))
      .filter((skill) => Boolean(skill.icon)),
  }))
  .filter(({ skills }) => skills.length > 1);
---

<div class="space-y-2 col-[extra]!">
  {
    rows.map(({ category, skills }, i) => (
      <IconMarquee
        skills={skills}
        crossingTime={crossingTimeFor(skills.length)}
        gap={skills.length > (MIN_ITEMS + MAX_ITEMS) / 2 ? 8 : 16}
        direction={i % 2 === 0 ? 'forwards' : 'reverse'}
        ariaLabel={`Scrolling list of ${category} used`}
      />
    ))
  }
</div>
