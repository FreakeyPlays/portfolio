---
import { type CollectionEntry, render } from 'astro:content';
import Career from '@blocks/career/Component.astro';
import Contact from '@blocks/contact/Component.astro';
import Education from '@blocks/education/Component.astro';
import a from "@blocks/elements/A.astro"
import h2 from "@blocks/elements/headings/H2.astro"
import Marquee from '@blocks/marquee/Component.astro';
import Navigation from '@blocks/navigation/Component.astro';
import Projects from '@blocks/projects/Component.astro';
import Typewriter from '@blocks/typewriter/Component.astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { isAstroComponentFactory } from 'astro/runtime/server/render/astro/factory.js';

interface Props {
	markdown: CollectionEntry<'pages' | 'posts'> | AstroComponentFactory;
}

const { markdown } = Astro.props;

const Content = !isAstroComponentFactory(markdown) ? (await render(markdown)).Content : markdown;
---

<Content
	components={{ Typewriter, Contact, Navigation, Marquee, Career, Education, Projects, h2, a }}
/>
