---
interface Props {
  href: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  rel?: string;
  class?: string;
  [key: string]: unknown;
}

const { href, target, rel, class: className = '', ...rest } = Astro.props;


function isExternalLink(link: string): boolean {
  if (!Astro.site) return false;

	const bareHost = (host: string) => host.replace(/^www\./, '');

  try {
    const url = new URL(link, Astro.site);

    if (url.protocol !== 'https:' && url.protocol !== 'http:') return false;

    return bareHost(url.hostname) !== bareHost(Astro.site.hostname);
  } catch {
    return false;
  }
}

const isExternal = isExternalLink(href);

const relTokens = [...(rel ?? '').split(' '), ...(isExternal ? ['noopener', 'noreferrer'] : [])]
  .map((token) => token.trim())
  .filter((token, index, all) => token && all.indexOf(token) === index);
---

<!-- Same per-line hover underline as components/HighlightLink.astro. -->
<a
	class:list={[
		'bg-linear-to-br from-lime-400 to-green-600 bg-no-repeat bg-bottom box-decoration-clone',
		'bg-size-[0%_2px] hover:bg-size-[100%_2px] transition-[background-size] duration-150 ease-in-out motion-reduce:transition-none',
		className,
	]}
	href={href}
	target={target ?? (isExternal ? '_blank' : undefined)}
	rel={relTokens.length > 0 ? relTokens.join(' ') : undefined}
	data-umami-event={isExternal ? 'outbound-link-click' : undefined}
	data-umami-event-url={isExternal ? href : undefined}
	{...rest}
>
	<span class="bg-linear-to-br from-lime-400 to-green-600 bg-clip-text text-transparent"><slot /></span>
</a>
