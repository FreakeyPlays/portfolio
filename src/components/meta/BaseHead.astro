---
import { Font } from 'astro:assets';
import Favicon from '@components/meta/Favicon.astro';
import SEO from '@components/meta/SEO.astro';
import { formatDayMonthYear, toISODateTime } from '@utils/date.ts';
import { getPerson } from '@utils/person.ts';
import { buildArticleGraph, buildProfileGraph } from '@utils/schema.ts';
import { getSite } from '@utils/site.ts';
import { getSocialPreview, type SocialOverride } from '@utils/socialPreview.ts';

export type ArticleMeta = {
  publishedAt?: Date;
  updatedAt: Date;
  section?: string;
  tags?: string[];
  readingTime?: number;
};

export type Props = {
  title?: string;
  rawTitle?: string;
  description?: string;
  canonicalURL?: URL | null;
  pageType?: 'website' | 'article';
  author?: string;
  noindex?: boolean;
  profileSchema?: boolean;
  article?: ArticleMeta;
  social?: SocialOverride;
};

const [person, site] = await Promise.all([getPerson(), getSite()]);

const {
  rawTitle,
  description = site.description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  pageType = 'website',
  author = person.name.full,
  noindex = false,
  profileSchema = false,
  article,
  social: socialOverride,
} = Astro.props;

const profileGraph =
  profileSchema && Astro.site ? await buildProfileGraph(Astro.site) : null;

const title =
  rawTitle ??
  (Astro.props.title
    ? `${Astro.props.title} | ${person.name.full}`
    : `${person.name.full} – ${person.tagline}`);

const social = await getSocialPreview(Astro.site, { pageType, override: socialOverride });

const articleURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site);

const og = article
  ? {
      ...social.og,
      article: {
        publishedTime: article.publishedAt ? toISODateTime(article.publishedAt) : undefined,
        modifiedTime: toISODateTime(article.updatedAt),
        author: {
          firstName: person.name.first,
          lastName: person.name.last,
          username: person.alternateName,
        },
        section: article.section,
        tags: article.tags,
      },
    }
  : social.og;

const labels = article
  ? [
      ...(article.readingTime
        ? [{ label: 'Reading time', data: `${article.readingTime} min read` }]
        : []),
      ...(article.publishedAt
        ? [{ label: 'Published', data: formatDayMonthYear(article.publishedAt) }]
        : []),
    ]
  : [];

const twitter = labels.length > 0 ? { ...social.twitter, labels } : social.twitter;

const articleGraph =
  article && Astro.site
    ? await buildArticleGraph(Astro.site, {
        url: articleURL,
        title: Astro.props.title ?? title,
        description,
        image: social.image.src,
        publishedAt: article.publishedAt,
        updatedAt: article.updatedAt,
        section: article.section,
        tags: article.tags ?? [],
      })
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0c0a09" />
<Font cssVariable="--font-montserrat" preload={true} />
<Font cssVariable="--font-inter" preload={true} />
{
  import.meta.env.PROD && (
    <script
      async
      is:inline
      data-astro-rerun
      src="https://static.chrismerck.dev/script.js"
      data-website-id="c7c4e802-1032-40aa-9dd8-dc62b220251e"
    />
  )
}
<Favicon />
<link rel="sitemap" href="/sitemap-index.xml" />
<SEO
  name={person.name.full}
  title={title}
  description={description}
  image={social.image}
  og={og}
  twitter={twitter}
  canonicalURL={canonicalURL}
  author={author}
  noindex={noindex}
/>
{
  profileGraph && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profileGraph)} />
  )
}
{
  articleGraph && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleGraph)} />
  )
}
