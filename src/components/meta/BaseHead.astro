---
import { Font } from 'astro:assets';
import Favicon from '@components/meta/Favicon.astro';
import SEO, { type Image } from '@components/meta/SEO.astro';
import siteInfo from '@data/siteInfo.json';
import { buildProfileGraph } from '@utils/schema.ts';

export type Props = {
  title?: string;
  rawTitle?: string;
  description?: string;
  image?: Image;
  canonicalURL?: URL | null;
  pageType?: 'website' | 'article';
  author?: string;
  noindex?: boolean;
  profileSchema?: boolean;
};

const {
  rawTitle,
  description = siteInfo.description,
  image = siteInfo.image,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  pageType = 'website',
  author = siteInfo.fullName,
  noindex = false,
  profileSchema = false,
} = Astro.props;

const profileGraph =
  profileSchema && Astro.site ? await buildProfileGraph(Astro.site) : null;

const title =
  rawTitle ??
  (Astro.props.title
    ? `${Astro.props.title} | ${siteInfo.fullName}`
    : `${siteInfo.fullName} — ${siteInfo.tagline}`);
const resolvedImage: Image = {
  src: new URL(image.src, Astro.site).toString(),
  alt: image.alt,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0c0a09" />
<Font cssVariable="--font-montserrat" preload={true} />
<Font cssVariable="--font-inter" preload={true} />
{
  import.meta.env.PROD && (
    <script
      async
      is:inline
      data-astro-rerun
      src="https://umami.chrismerck.dev/script.js"
      data-website-id="c7c4e802-1032-40aa-9dd8-dc62b220251e"
    />
  )
}
<Favicon />
<link rel="mask-icon" href="/favicon.svg" color="#8BC225" />
<link rel="sitemap" href="/sitemap-index.xml" />
<SEO
  name={siteInfo.fullName}
  title={title}
  description={description}
  image={resolvedImage}
  og={{ type: pageType }}
  canonicalURL={canonicalURL}
  author={author}
  noindex={noindex}
/>
{
  profileGraph && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profileGraph)} />
  )
}
