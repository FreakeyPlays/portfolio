---
import { Font } from 'astro:assets';
import Favicon from '@components/meta/Favicon.astro';
import SEO from '@components/meta/SEO.astro';
import { getPerson } from '@utils/person.ts';
import { buildProfileGraph } from '@utils/schema.ts';
import { getSite } from '@utils/site.ts';
import { getSocialPreview } from '@utils/socialPreview.ts';

export type Props = {
  title?: string;
  rawTitle?: string;
  description?: string;
  canonicalURL?: URL | null;
  pageType?: 'website' | 'article';
  author?: string;
  noindex?: boolean;
  profileSchema?: boolean;
};

const [person, site] = await Promise.all([getPerson(), getSite()]);

const {
  rawTitle,
  description = site.description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  pageType = 'website',
  author = person.name.full,
  noindex = false,
  profileSchema = false,
} = Astro.props;

const profileGraph =
  profileSchema && Astro.site ? await buildProfileGraph(Astro.site) : null;

const title =
  rawTitle ??
  (Astro.props.title
    ? `${Astro.props.title} | ${person.name.full}`
    : `${person.name.full} – ${person.tagline}`);

const social = await getSocialPreview(Astro.site, { pageType });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0c0a09" />
<Font cssVariable="--font-montserrat" preload={true} />
<Font cssVariable="--font-inter" preload={true} />
{
  import.meta.env.PROD && (
    <script
      async
      is:inline
      data-astro-rerun
      src="https://static.chrismerck.dev/script.js"
      data-website-id="c7c4e802-1032-40aa-9dd8-dc62b220251e"
    />
  )
}
<Favicon />
<link rel="sitemap" href="/sitemap-index.xml" />
<SEO
  name={person.name.full}
  title={title}
  description={description}
  image={social.image}
  og={social.og}
  twitter={social.twitter}
  canonicalURL={canonicalURL}
  author={author}
  noindex={noindex}
/>
{
  profileGraph && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profileGraph)} />
  )
}
