---
import MarqueeItem from './MarqueeItem.astro';

export type MarqueeSkill = {
  name: string;
  icon: ((_props: astroHTML.JSX.SVGAttributes) => unknown) & ImageMetadata;
};

interface Props {
  skills: MarqueeSkill[];
  direction?: 'forwards' | 'reverse';
  crossingTime?: number;
  gap?: number;
  ariaLabel?: string;
  class?: string;
}

const {
  skills,
  direction = 'forwards',
  crossingTime = 5,
  gap = 8,
  ariaLabel,
  class: className,
} = Astro.props;

const duration = Math.round((crossingTime * skills.length * 100) / (skills.length - 1)) / 100;
---

<div class:list={['@container overflow-hidden mask-x-from-90% mask-x-to-100% motion-reduce:mask-none', className]}>
  <ul
    aria-label={ariaLabel}
    class="grid grid-cols-[100cqw_[track]_0px[resting]] w-max hover:*:pause-animation! motion-reduce:*:pause-animation! motion-reduce:[--reducedMotion:0] [--reducedMotion:1]"
  >
    {skills.map(({ name, icon }, i) => <MarqueeItem name={name} icon={icon} index={i} />)}
  </ul>
</div>

<style
  define:vars={{
    marqueeDuration: `${duration}s`,
    direction: direction,
    marqueeItems: `${skills.length}`,
    itemGap: `${gap}px`,
    itemWidth: `calc(calc(100cqw - calc(var(--marqueeItems) * var(--itemGap))) / calc(var(--marqueeItems) - var(--reducedMotion)))`,
  }}
></style>
