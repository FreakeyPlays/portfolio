---
import { formatDayMonthYear } from '@utils/dateFormat';

export type PostHero = {
  readingTime: number;
  wordCount: number;
  title: string;
  description: string;
  publishedAt: Date;
}

interface Props {
  meta: PostHero;
}

const { title, description, readingTime, publishedAt } = Astro.props.meta;
---

<header class="col-[extra]! text-body-large text-pretty space-y-8">
  <h1 class="xl:text-heading-00 md:text-heading-01 text-heading-02 mt-16">{title}</h1>

  <Fragment set:html={description} />

  {publishedAt && (
    <div class="text-body-small text-stone-400">
      Published on <time datetime={publishedAt.toISOString()}>{formatDayMonthYear(publishedAt)}</time>
      {readingTime > 0 && <span aria-hidden="true"> &middot; {readingTime}min read</span>}
    </div>
  )}

  <hr class="text-stone-700" />
</header>
