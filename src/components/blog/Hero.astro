---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  intro: string;
  image: ImageMetadata;
  readingTime: number;
}

const { title, intro, image, readingTime } = Astro.props;
---

<header class="col-[extra]! text-body-large text-pretty space-y-8">
  <h1 class="xl:text-heading-00 md:text-heading-01 text-heading-02 mt-16">{title}</h1>
  
  <Fragment
    set:html={intro}
  />

  <hr class=" text-stone-700" />
</header>
