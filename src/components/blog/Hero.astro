---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  intro: string;
  image: ImageMetadata;
  readingTime: number;
}

const { title, intro, image, readingTime } = Astro.props;
---

<header class="contents *:col-[content]">
  <h1 class="mt-12">{title}</h1>
  <div class="my-4 text-body-large" set:html={intro} />
  <p class="my-2 text-body-small!">
    <span>Published: </span><time>18.08.2026</time>
    <Fragment>{' - '}<span>Reading time: </span>{readingTime} min</Fragment>
  </p>
  <hr class="my-2">
  <Image src={image} alt="test" class="bg-red-400 aspect-video rounded-4xl xl:col-[extra]! col-[image]!"></Image>
  <hr class="my-2">
</header>
