---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  intro: string;
  image: ImageMetadata;
  readingTime: number;
}

const { title, intro, image, readingTime } = Astro.props;
---

<header class="contents *:col-[content]">
  <Image
    src={image}
    alt=""
    class="xl:aspect-16/7 md:aspect-video aspect-16/11 rounded-b-2xl! xl:col-start-[aside-left]! xl:col-end-[aside-right]! col-[full]! object-cover"
  />

  <div class="text-balance -mt-32 p-4 md:col-[extra]! col-[content]! z-10">
    <p
      class="flex flex-wrap items-center gap-x-3 gap-y-1 text-body-small! tracking-widest text-neutral-300"
    >
      <time datetime="2026-08-18">18.08.2026</time>
      <span aria-hidden="true" class="size-1 rounded-full bg-lime-400"></span>
      <span>{readingTime} min read</span>
    </p>

    <h1 class="mt-3 xl:text-heading-00 text-heading-01">{title}</h1>

    <div
      class="mt-6 text-body-large"
      set:html={intro}
    />
  </div>
</header>
