---
import type { TocEntry } from '@utils/buildTableOfContents';

interface Props {
  entries: TocEntry[];
  nested?: boolean;
}

const { entries, nested = false } = Astro.props;
---

<ol class:list={[nested && 'mb-1 ps-4']}>
  {
    entries.map(({ slug, text, children }) => (
      <li>
        <a
          href={`#${slug}`}
          class:list={[
            'transition-colors hover:text-lime-400',
            nested ? 'text-neutral-500' : 'text-neutral-300',
          ]}
        >
          {text}
        </a>
        {children.length > 0 && <Astro.self entries={children} nested />}
      </li>
    ))
  }
</ol>
