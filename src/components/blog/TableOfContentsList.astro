---
import type { TocEntry } from '@utils/buildTableOfContents';

interface Props {
  entries: TocEntry[];
  nested?: boolean;
}

const { entries, nested = false } = Astro.props;
---

<ol class={nested ? 'mb-1 pl-3' : "mt-4"}>
  {
    entries.map(({ slug, text, children }) => (
      <li>
        <a
          href={`#${slug}`}
          class:list={[
            'block px-3 py-1.5 rounded-lg transition-colors hover:text-lime-400 hover:bg-stone-700',
            nested ? 'text-body-small text-neutral-400' : 'text-body text-neutral-300',
          ]}
        >
          {text}
        </a>
        {children.length > 0 && <Astro.self entries={children} nested />}
      </li>
    ))
  }
</ol>
