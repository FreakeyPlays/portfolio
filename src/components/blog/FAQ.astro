---
interface Props {
  items?: { question: string; answer: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{
  items && items.length > 0 && (
    <section aria-labelledby="faq" class={className}>
      <h2 id="faq">
        FAQ
      </h2>
      <ul class="mt-6 space-y-2">
        {items.map(({ question, answer }) => (
          <li class="rounded-2xl border border-gray-700 bg-zinc-900">
            <details class="group px-4 py-4">
              <summary class="flex cursor-pointer gap-3 font-semibold group-open:mb-6">
                {question}
                <span
                  class="ml-auto text-neutral-400 transition-transform group-open:rotate-180"
                  aria-hidden="true"
                >
                  &#9662;
                </span>
              </summary>
              <Fragment set:html={answer} />
            </details>
          </li>
        ))}
      </ul>
    </section>
  )
}
