---
import { getCollection, getEntry, render } from 'astro:content';
import { formatMonthYear, toISODate } from '@lib/date';
import BaseSection from './BaseSection.astro';

const educationCollection = (await getCollection('education', ({ data }) => data.isPublished)).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);
const intro = await getEntry('sections', 'index-education');
const Content = intro ? (await render(intro)).Content : null;
---

<BaseSection title={intro?.data.title ?? 'education'}>
  {
    Content && (
      <div class="mt-4 space-y-2">
        <Content />
      </div>
    )
  }
  <ul class="space-y-4 mt-16">
    {
      educationCollection.map((education) => (
        <li>
          <h3 class="text-xl font-bold">{education.data.degree}</h3>
          <p class="text-lg font-bold bg-gradient-to-br from-lime-400 to-green-600 bg-clip-text text-transparent">
            @{education.data.institution}
          </p>
          <p class="text-sm text-gray-400 uppercase">
            <span class="capitalize">
              {education.data.location}{' '}
              {education.data.grade ? `| Grade: ${education.data.grade}` : ''}
            </span>{' '}
            |{' '}
            <time datetime={toISODate(education.data.startDate)}>
              {formatMonthYear(education.data.startDate)}
            </time>{' '}
            -{' '}
            {education.data.endDate ? (
              <time datetime={toISODate(education.data.endDate)}>
                {formatMonthYear(education.data.endDate)}
              </time>
            ) : (
              'present'
            )}
          </p>
        </li>
      ))
    }
  </ul>
</BaseSection>
