---
import { getCollection, getEntry, render } from 'astro:content';
import IconMarquee from '@components/marquee/IconMarquee.astro';
import BaseSection from './BaseSection.astro';

type SkillIcon = ((_props: astroHTML.JSX.SVGAttributes) => unknown) & ImageMetadata;

const iconModules = import.meta.glob('../../assets/icons/skills/*.svg', {
  eager: true,
  import: 'default',
}) as Record<string, SkillIcon>;

const iconFor = (imagePath: string) =>
  iconModules[`../../assets/icons/skills/${imagePath.split('/').pop()}`];

const skillCategories = await getCollection('skills');
const skillsFor = (id: string) =>
  skillCategories
    .find((category) => category.id === id)
    ?.data.skills.filter((skill) => skill.isPublished && skill.image)
    .map((skill) => ({ name: skill.name, icon: iconFor(skill.image as string) }))
    .filter((skill) => Boolean(skill.icon)) ?? [];

const languages = skillsFor('languages');
const frameworks = skillsFor('frameworks');
const tools = skillsFor('tools');

const intro = await getEntry('sections', 'index-skills');
const Content = intro ? (await render(intro)).Content : null;
---

<BaseSection title={intro?.data.title ?? 'skills'}>
  {
    Content && (
      <div class="mt-4 space-y-2">
        <Content />
      </div>
    )
  }
  <div class="mt-16 space-y-2">
    <IconMarquee
      skills={languages}
      speed={30}
      gap={16}
      direction="reverse"
      ariaLabel="Scrolling list of programming languages used"
    />
    <IconMarquee
      skills={frameworks}
      speed={40}
      gap={32}
      ariaLabel="Scrolling list of frameworks used"
    />
    <IconMarquee
      skills={tools}
      speed={20}
      gap={16}
      direction="reverse"
      ariaLabel="Scrolling list of tools used"
    />
  </div>
</BaseSection>
