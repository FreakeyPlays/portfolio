---
interface Props {
  href: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  rel?: string;
  class?: string;
  [key: string]: unknown;
}

const { href, target = '_self', rel = '', class: className = '', ...rest } = Astro.props;
---

<!--
  The hover underline is the link's background (so it can grow from the center),
  and box-decoration-clone repeats it under every wrapped line. The gradient text
  therefore lives on the inner span. Keep in sync with blocks/elements/A.astro.
-->
<a
  class:list={[
    'bg-linear-to-br from-lime-400 to-green-600 bg-no-repeat bg-bottom box-decoration-clone',
    'bg-size-[0%_2px] hover:bg-size-[100%_2px] transition-[background-size] duration-150 ease-in-out motion-reduce:transition-none',
    className,
  ]}
  href={href}
  target={target}
  rel={rel}
  {...rest}
>
  <span class="bg-linear-to-br from-lime-400 to-green-600 bg-clip-text text-transparent"><slot /></span>
</a>
