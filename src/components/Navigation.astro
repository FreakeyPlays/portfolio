---
import { pages as links, type Page } from '@data/pages';
import CloseIcon from '../assets/ui/close.svg';
import NavigationIcon from '../assets/ui/navigation.svg';
import Grain from './Grain.astro';

const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const isHome = currentPath === '/';

const resolveHref = (page: Page) => (isHome || !page.url.startsWith('#') ? page.url : `/${page.url}`);

const isCurrent = (page: Page) => !isHome && !page.homeSection && page.url.replace(/(.)\/$/, '$1') === currentPath;
---

<nav
  aria-label="Primary"
  data-home={isHome}
  class:list={[
    'z-50 mx-2 h-16 p-2 pr-8 isolate rounded-full bg-gray-200/20 sticky top-4 shadow-xl col-[image]! border border-white/20 flex items-center justify-between',
    "before:content-[''] before:absolute before:inset-0 before:backdrop-blur-sm before:rounded-full before:-z-1",
  ]}
>
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0 rounded-full">
    <Grain />
  </div>

  <a
    class="bg-gradient-to-tr z-10 from-lime-400 to-green-600 w-24 h-12 rounded-full"
    href="/"
    aria-label="Home"
  >
    <span class="sr-only">Home</span>
  </a>

  <button
    type="button"
    id="menu-toggle"
    class="cursor-pointer md:hidden"
    aria-expanded="false"
    aria-controls="nav-list"
  >
    <span class="sr-only">Toggle main menu</span>
    <NavigationIcon id="menu-toggle-open" class="h-8 w-8" />
    <CloseIcon id="menu-toggle-close" class="h-8 w-8 hidden" />
  </button>

  <ul
    id="nav-list"
    class:list={[
      'hidden absolute mt-4 left-0 right-0 top-full rounded-4xl overflow-hidden bg-gray-200/20 backdrop-blur-md border border-white/20 space-y-2 py-4',
      'md:flex md:relative md:mt-0 md:top-0 md:bg-transparent md:border-none md:backdrop-blur-none md:gap-3 md:space-y-0 md:overflow-visible',
    ]}
  >
    <Grain class="md:hidden" />
    {
      links.map((el) => (
        <li
          class:list={[
            'w-fit mx-auto',
            'has-[.active-nav-link]:bg-gradient-to-br has-[.active-nav-link]:from-lime-400 has-[.active-nav-link]:to-green-600 has-[.active-nav-link]:text-transparent has-[.active-nav-link]:bg-clip-text',
            "relative after:content-[''] after:absolute after:-bottom-0.5 after:left-0 after:w-full after:h-0.5 after:bg-gradient-to-br after:from-lime-400 after:to-green-600 after:transition-transform after:scale-x-0 after:origin-center hover:after:scale-x-100",
          ]}
        >
          <a
            href={resolveHref(el)}
            data-home-link={el.homeSection}
            aria-current={isCurrent(el) ? 'page' : undefined}
            class:list={['text-lg font-bold inline-block', isCurrent(el) && 'active-nav-link']}
            set:html={`<span class="text-white">/</span>${el.label}`}
          />
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const openIcon = document.getElementById('menu-toggle-open');
  const closeIcon = document.getElementById('menu-toggle-close');
  const navList = document.getElementById('nav-list');
  const navItems = document.querySelectorAll('#nav-list li');

  if (toggle && navList && openIcon && closeIcon) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');

      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      navList.classList.toggle('hidden');
    });

    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        navList.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('click', (event) => {
      const isClickInsideNav = event.target ? navList.contains(event.target as Node) : false;
      const isClickOnToggle = event.target ? toggle.contains(event.target as Node) : false;

      if (!navList.classList.contains('hidden') && !isClickInsideNav && !isClickOnToggle) {
        navList.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  type SectionLink = { link: HTMLAnchorElement; heading: HTMLElement | null };

  const sectionLinks: SectionLink[] = [];
  const isHomePage = navList?.closest('nav')?.dataset.home === 'true';

  if (isHomePage) {
    navList?.querySelectorAll<HTMLAnchorElement>('[data-home-link="true"]').forEach((link) => {
      const id = link.getAttribute('href')?.split('#')[1];

      if (!id) {
        sectionLinks.push({ link, heading: null });
        return;
      }

      const heading = document.getElementById(id);
      if (heading) sectionLinks.push({ link, heading });
    });
  }

  sectionLinks.sort((a, b) => {
    if (!a.heading) return -1;
    if (!b.heading) return 1;

    return a.heading.compareDocumentPosition(b.heading) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
  });

  const firstHeading = sectionLinks.find((entry) => entry.heading)?.heading;

  if (firstHeading) {
    const spyLine = () => {
      const scrollMargin = Number.parseFloat(getComputedStyle(firstHeading).scrollMarginTop);

      return (Number.isFinite(scrollMargin) ? scrollMargin : 96) + 4;
    };

    let currentActive: HTMLAnchorElement | null = null;

    const setActive = (link: HTMLAnchorElement) => {
      if (link === currentActive) return;

      if (currentActive) {
        currentActive.classList.remove('active-nav-link');
        currentActive.removeAttribute('aria-current');
      }

      link.classList.add('active-nav-link');
      link.setAttribute('aria-current', 'true');
      currentActive = link;
    };

    const update = () => {
      const line = spyLine();
      const atBottom =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

      if (atBottom) {
        setActive(sectionLinks[sectionLinks.length - 1].link);
        return;
      }

      let active = sectionLinks[0].link;
      for (const entry of sectionLinks) {
        if (entry.heading && entry.heading.getBoundingClientRect().top > line) break;
        active = entry.link;
      }

      setActive(active);
    };

    let frame = 0;
    const scheduleUpdate = () => {
      if (frame) return;

      frame = requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('load', scheduleUpdate);

    update();
  }
</script>
