---
import { getSocials } from '@utils/socials.ts';
import PrideFlag from './PrideFlag/PrideFlag.astro';
import SocialIconLink from './SocialIconLink.astro';

type SocialIcon = ((_props: astroHTML.JSX.SVGAttributes) => unknown) & ImageMetadata;

const iconModules = import.meta.glob('../assets/icons/social/*.svg', {
  eager: true,
  import: 'default',
}) as Record<string, SocialIcon>;

const iconFor = (imagePath: string) =>
  iconModules[`../assets/icons/social/${imagePath.split('/').pop()}`];

const socials = await getSocials();
---

<footer class="col-[image]!">
  <hr class="border-neutral-600" />
  <div class="flex flex-row justify-between items-center py-8">
    <a
      target="_blank"
      rel="noopener noreferrer"
      class='relative after:content-[""] after:absolute after:-bottom-0.5 after:left-0 after:w-full after:h-0.5 after:bg-gradient-to-br after:from-lime-400 after:to-green-600 after:transition-transform after:scale-x-0 after:origin-center hover:after:scale-x-100'
      href="https://github.com/FreakeyPlays/portfolio/blob/master/LICENSE"
    >
      MIT License &copy; {new Date().getFullYear()}&nbsp;
    </a>
    <PrideFlag width={50} numberOfColumns={20} billow={0.15} />
    <ul class="flex flex-row gap-4">
      {
        socials.map(({ href, icon, text }) => (
          <li>
            <SocialIconLink icon={iconFor(icon)} href={href} text={text} />
          </li>
        ))
      }
    </ul>
  </div>
</footer>
