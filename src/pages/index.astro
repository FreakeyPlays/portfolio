---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import RenderBlocks from '@blocks/RenderBlocks.astro';

const home = await getEntry('home', 'index');
if (!home) throw new Error('Missing content entry: src/content/pages/index.mdx');
---

<BaseLayout profileSchema>
  <RenderBlocks markdown={home} />
</BaseLayout>
