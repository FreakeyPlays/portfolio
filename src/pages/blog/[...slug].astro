---
import { getCollection, render } from 'astro:content';
import { createSatteriMarkdownProcessor } from '@astrojs/markdown-satteri';
import RenderBlocks from '@blocks/RenderBlocks.astro';
import PostLayout from '@layouts/PostLayout.astro';
import { buildTableOfContents } from '@utils/buildTableOfContents';
import { removeHtmlTags } from '@utils/removeHtmlTags';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const reservedIds = ['blog', 'index'];
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !reservedIds.includes(post.id))
    .filter((post) => post.data.isPublished || import.meta.env.DEV)
    .map((post) => ({
      params: { slug: post.data.customSlug ?? post.data.slug },
      props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { headings, Content, remarkPluginFrontmatter } = await render(post);
const toc = buildTableOfContents(headings);
const readingTime = remarkPluginFrontmatter.readingTime as number;
const processor = await createSatteriMarkdownProcessor();

const { code: intro } = await processor.render(post.data.intro);
const description = removeHtmlTags(intro);
const faq = await Promise.all(
  post.data.faq.map(async ({ question, answer }) => ({
    question,
    answer: (await processor.render(answer)).code,
  })),
);
---

<PostLayout
  title={post.data.title}
  intro={intro}
  image={post.data.image}
  description={description}
  faq={faq}
  toc={toc}
  readingTime={readingTime}
  publishedAt={post.data.publishedAt}
>
  <RenderBlocks markdown={Content} />
</PostLayout>
