---
import { getCollection, render } from 'astro:content';
import RenderBlocks from '@blocks/RenderBlocks.astro';
import type { PostHero } from '@components/blog/Hero.astro';
import { isProduction } from '@constants';
import PostLayout from '@layouts/PostLayout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const reservedIds = ['blog', 'index', ""];
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !reservedIds.includes(post.data.slug))
    .filter((post) => post.data.isPublished || !isProduction)
    .map((post) => ({
      params: { slug: post.data.slug },
      props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const postMetadata: PostHero = {
  title: post.data.title,
  description: post.data.description,
  readingTime: remarkPluginFrontmatter.readingTime,
  wordCount: remarkPluginFrontmatter.wordCount,
  publishedAt: post.data.publishedAt ?? post.data.updatedAt,
}
---

<PostLayout entity={post} toc={remarkPluginFrontmatter.toc} postMetadata={postMetadata}>
  <RenderBlocks markdown={Content} />
</PostLayout>
