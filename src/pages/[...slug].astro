---
import { getCollection } from 'astro:content';
import RenderBlocks from '@blocks/RenderBlocks.astro';
import PageLayout from '@layouts/PageLayout.astro';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths = (async () => {
  const reservedIds = ['index', 'home', '404'];

  const pages = await getCollection('pages');

  return pages
    .filter((page) => !reservedIds.includes(page.data.slug))
    .filter((page) => page.data.isPublished || import.meta.env.DEV)
    .map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
---

<PageLayout page={page}>
  <RenderBlocks markdown={page} />
</PageLayout>
