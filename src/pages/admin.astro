<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Content Manager</title>
		<style>
			#umami-toggle {
				position: fixed;
				right: 0.75rem;
				bottom: 0.75rem;
				z-index: 1000;
				padding: 0.35rem 0.7rem;
				border: 1px solid;
				border-radius: 999px;
				background: #1c1917;
				color: #a1a1aa;
			}

			#umami-toggle[data-tracking='off'] {
				color: #4BB543;
			}
		</style>
	</head>
	<body>
		<script>
			import CMS from '@sveltia/cms';

			CMS.init();
		</script>

		<button id="umami-toggle" type="button"></button>

		<script>
			const KEY = 'umami.disabled';
			const button = document.querySelector<HTMLButtonElement>('#umami-toggle');

			const render = () => {
				if (!button) return;
				const isDisabled = localStorage.getItem(KEY) === '1';
				button.dataset.tracking = isDisabled ? 'off' : 'on';
				button.textContent = isDisabled ? 'Analytics off' : 'Analytics on';
				button.disabled = isDisabled;
			};

			button?.addEventListener('click', () => {
				localStorage.setItem(KEY, '1');
				render();
			});

			render();
		</script>
	</body>
</html>
