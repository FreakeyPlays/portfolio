---
import { getImage, Image } from 'astro:assets';
import FAQ from '@components/blog/FAQ.astro';
import BlogHero from '@components/blog/Hero.astro';
import TableOfContents from '@components/blog/TableOfContents.astro';
import Navigation from '@components/Navigation.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { TocEntry } from '@utils/buildTableOfContents';
import { removeHtmlTags } from '@utils/removeHtmlTags';
import type { Breadcrumb } from '@utils/schema.ts';
import { socialImageType } from '@utils/socialPreview.ts';

export interface Props {
  title: string;
  intro: string;
  image: ImageMetadata;
  description: string;
  readingTime: number;
  faq?: { question: string; answer: string }[];
  toc?: TocEntry[];
  publishedAt?: Date;
  updatedAt: Date;
  tags?: string[];
  category?: string;
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  intro,
  image,
  description,
  faq,
  toc = [],
  readingTime,
  publishedAt,
  updatedAt,
  tags,
  category,
  breadcrumbs,
} = Astro.props;

const card = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});

const faqFacts = faq?.map(({ question, answer }) => ({
  question,
  answer: removeHtmlTags(answer),
}));

const social = Astro.site
  ? {
      description,
      image: {
        src: new URL(card.src, Astro.site).toString(),
        alt: title,
        width: card.options.width,
        height: card.options.height,
        type: socialImageType(card.options.format),
      },
    }
  : { description };
---

<BaseLayout
  title={title}
  description={description}
  pageType="article"
  article={{
    publishedAt,
    updatedAt,
    section: category,
    tags,
    readingTime,
    faq: faqFacts,
  }}
  social={social}
  breadcrumbs={breadcrumbs}
>
  <Navigation slot="header" />
  
  <article class="contents *:col-[content]">

    <BlogHero title={title} intro={intro} readingTime={readingTime} publishedAt={publishedAt} />

    {
      toc.length > 0 && (
        <aside class="col-[aside-left]! xl:top-8 xl:row-start-3 xl:row-end-5 row-start-4 row-end-5 xl:self-start xl:sticky xl:mt-8 mt-8">
          <TableOfContents entries={toc} />
        </aside>
      )
    }

    <Image src={image} alt="" class="rounded-xl shadow-xl shadow-black/30 mt-8" />

    <div class="flow disable mt-8">
      <slot />
    </div>

    <FAQ class="my-8" items={faq} />
  </article>
</BaseLayout>
