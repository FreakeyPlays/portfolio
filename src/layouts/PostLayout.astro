---
import FAQ from '@components/blog/FAQ.astro';
import BlogHero from '@components/blog/Hero.astro';
import TableOfContents from '@components/blog/TableOfContents.astro';
import Navigation from '@components/Navigation.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { TocEntry } from '@utils/buildTableOfContents';


export interface Props {
	title: string
	intro: string
	image: ImageMetadata
	description: string
	readingTime: number
	faq?: {question: string; answer: string}[]
	toc?: TocEntry[]
}

const { title, intro, image, description, faq, toc = [], readingTime } = Astro.props;
---

<BaseLayout title={title} description={description} pageType="article">
  <Navigation slot="header" />

  <article class="contents *:col-[content]">
    <BlogHero title={title} intro={intro} image={image} readingTime={readingTime} />

    {toc.length > 0 && (
      <aside class="col-[aside-left]!">
        <TableOfContents entries={toc} />
      </aside>
    )}
    
    <div class="flow">
      <slot />
    </div>

    <FAQ class="my-8" items={faq} />
  </article>
  
</BaseLayout>
