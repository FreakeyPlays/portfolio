---
import { Image } from 'astro:assets';
import FAQ from '@components/blog/FAQ.astro';
import BlogHero from '@components/blog/Hero.astro';
import ReadingProgress from '@components/blog/ReadingProgress.astro';
import TableOfContents from '@components/blog/TableOfContents.astro';
import Navigation from '@components/Navigation.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { TocEntry } from '@utils/buildTableOfContents';

export interface Props {
  title: string;
  intro: string;
  image: ImageMetadata;
  description: string;
  readingTime: number;
  faq?: { question: string; answer: string }[];
  toc?: TocEntry[];
  publishedAt?: Date;
}

const { title, intro, image, description, faq, toc = [], readingTime, publishedAt } = Astro.props;
---

<BaseLayout title={title} description={description} pageType="article">
  <Navigation slot="header" />
  
  <article class="contents *:col-[content]">

    <BlogHero title={title} intro={intro} readingTime={readingTime} publishedAt={publishedAt} />

    {
      toc.length > 0 && (
        <aside class="col-[aside-left]! xl:top-8 xl:row-start-3 xl:row-end-5 row-start-4 row-end-5 xl:self-start xl:sticky xl:mt-8 mt-8">
          <TableOfContents entries={toc} />
        </aside>
      )
    }

    <Image src={image} alt="" class="rounded-xl shadow-xl shadow-black/30 mt-8" />

    <div class="flow disable mt-8">
      <slot />
    </div>

    <FAQ class="my-8" items={faq} />
  </article>
</BaseLayout>
